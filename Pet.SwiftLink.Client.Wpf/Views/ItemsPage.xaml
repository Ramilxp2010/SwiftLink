<Page x:Class="Pet.SwiftLink.Desktop.Views.ItemPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:domain="clr-namespace:Pet.SwiftLink.Domain.Model;assembly=Pet.SwiftLink.Domain"
      d:DesignHeight="640"
      d:DesignWidth="760"
      Background="{StaticResource AppBackground}"
      ScrollViewer.CanContentScroll="False"
      mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate x:Key="LinkRowTemplate">
            <Border Style="{StaticResource ListRowStyle}"
                    ToolTip="{Binding Path}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40" CornerRadius="10"
                            Background="{StaticResource AccentSoftBrush}"
                            Margin="0,0,12,0">
                        <ui:SymbolIcon FontSize="18"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="Document24"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="{x:Static domain:QuickLinkType.Folder}">
                                            <Setter Property="Symbol" Value="Folder24"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="{x:Static domain:QuickLinkType.Application}">
                                            <Setter Property="Symbol" Value="Apps24"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding MetaLine}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                            CommandParameter="{Binding}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            Cursor="Hand"
                            ToolTip="Закрепить / открепить"
                            Margin="4,0">
                        <ui:SymbolIcon FontSize="16" Foreground="{StaticResource AccentBrush}">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="Star24"/>
                                    <Setter Property="Filled" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Filled" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Button>

                    <Button Grid.Column="3"
                            Command="{Binding DataContext.RemoveQuickLinkCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                            CommandParameter="{Binding}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            Cursor="Hand"
                            ToolTip="Удалить"
                            Margin="0,0,4,0">
                        <ui:SymbolIcon Symbol="Delete24" FontSize="16"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,24,24">
        <StackPanel>
            <!-- Search -->
            <Border Style="{StaticResource SearchBoxBorderStyle}" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Search24" Margin="12,0,4,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    <ui:TextBox x:Name="SearchBox"
                                Grid.Column="1"
                                PlaceholderText="Поиск ссылок..."
                                BorderThickness="0"
                                Background="Transparent"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                Padding="4,10"/>
                    <Border Grid.Column="2"
                            Background="{StaticResource AppBackground}"
                            CornerRadius="6"
                            Padding="8,4"
                            Margin="8,0,10,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="Ctrl+K"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Home: Quick Access + Recent -->
            <StackPanel Visibility="{Binding IsHomeView, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Быстрый доступ" Style="{StaticResource SectionTitleStyle}"/>

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,0,0,28">
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl ItemsSource="{Binding QuickAccessLinks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource HoverableCardStyle}"
                                            ToolTip="{Binding Path}"
                                            MouseLeftButtonDown="QuickAccessCard_MouseLeftButtonDown"
                                            Tag="{Binding}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="2"
                                                        Cursor="Hand">
                                                    <ui:SymbolIcon FontSize="14" Foreground="{StaticResource AccentBrush}">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Symbol" Value="Star24"/>
                                                                <Setter Property="Filled" Value="False"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                        <Setter Property="Filled" Value="True"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </Button>

                                                <Border Width="36" Height="36" CornerRadius="10"
                                                        Background="{StaticResource AccentSoftBrush}"
                                                        HorizontalAlignment="Left">
                                                    <ui:SymbolIcon FontSize="16"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Symbol" Value="Document24"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static domain:QuickLinkType.Folder}">
                                                                        <Setter Property="Symbol" Value="Folder24"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static domain:QuickLinkType.Application}">
                                                                        <Setter Property="Symbol" Value="Apps24"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </Border>
                                            </DockPanel>

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="36"
                                                       Margin="0,10,0,0"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Top"/>

                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding Category}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource AddCardStyle}"
                                MouseLeftButtonDown="AddCard_MouseLeftButtonDown"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1.5"
                                Background="#F8F7FF">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Add24" FontSize="22"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center"/>
                                <TextBlock Text="Добавить"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Text="Недавние" Style="{StaticResource SectionTitleStyle}"/>

                <ListBox ItemsSource="{Binding RecentLinks}"
                         SelectedItem="{Binding SelectedLink}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemTemplate="{StaticResource LinkRowTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseDoubleClick">
                            <b:InvokeCommandAction Command="{Binding OpenQuickLinkCommand}"
                                                   CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>

            <!-- Filtered views -->
            <StackPanel Visibility="{Binding IsFilteredView, Converter={StaticResource BoolToVis}}">
                <DockPanel Margin="0,0,0,16">
                    <TextBlock Text="{Binding ContentTitle}" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource NavItemStyle}"
                            Command="{Binding AddQuickLinkCommand}"
                            Padding="10,6"
                            Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" Margin="0,0,6,0" FontSize="14"
                                           Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Добавить" VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <TextBlock Text="Пока пусто"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,12,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilteredLinks.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="Корзина появится в следующих версиях."
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,8,0,0"
                           Visibility="{Binding IsTrashNavActive, Converter={StaticResource BoolToVis}}"/>

                <ListBox ItemsSource="{Binding FilteredLinks}"
                         SelectedItem="{Binding SelectedLink}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemTemplate="{StaticResource LinkRowTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseDoubleClick">
                            <b:InvokeCommandAction Command="{Binding OpenQuickLinkCommand}"
                                                   CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
