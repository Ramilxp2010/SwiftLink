<UserControl x:Class="Pet.SwiftLink.Desktop.Views.AddQuickLinkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Pet.SwiftLink.Desktop.ViewModels"
        xmlns:model="clr-namespace:Pet.SwiftLink.Domain.Model;assembly=Pet.SwiftLink.Domain"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d" MinWidth="360">

    <UserControl.DataContext>
        <viewModels:AddQuickLinkDialogViewModel/>
    </UserControl.DataContext>

    <StackPanel Margin="4">
        <Label Content="Тип"/>
        <ComboBox SelectedIndex="0" BorderThickness="1"
                  SelectedItem="{Binding SelectedType, Mode=TwoWay}"
                  Margin="0,0,0,8">
            <ComboBox.ItemsSource>
                <x:Array Type="{x:Type model:QuickLinkType}">
                    <model:QuickLinkType>Folder</model:QuickLinkType>
                    <model:QuickLinkType>File</model:QuickLinkType>
                    <model:QuickLinkType>Application</model:QuickLinkType>
                </x:Array>
            </ComboBox.ItemsSource>
        </ComboBox>

        <Label Content="Категория"/>
        <ComboBox ItemsSource="{Binding Categories}"
                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                  BorderThickness="1"
                  Margin="0,0,0,8"/>

        <ui:TextBox Margin="0,0,0,8" PlaceholderText="Псевдоним..."
                    BorderThickness="1"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

        <StackPanel Orientation="Horizontal">
            <ui:TextBox PlaceholderText="Путь..."
                        Width="300"
                        Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                        BorderThickness="1"/>
            <ui:Button Appearance="Secondary" Content="..." Width="36" Margin="8,0,0,0"
                       Command="{Binding BrowseCommand}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
