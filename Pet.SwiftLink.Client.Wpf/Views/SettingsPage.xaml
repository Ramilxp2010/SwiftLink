<Page x:Class="Pet.SwiftLink.Desktop.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      ScrollViewer.CanContentScroll="False">

    <Grid Background="{StaticResource AppBackground}">
        <Border Background="{StaticResource SurfaceBrush}"
                Margin="24"
                CornerRadius="14"
                Padding="24"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1">
            <StackPanel>
                <ui:TextBlock Appearance="Primary"
                              Text="Настройки"
                              FontTypography="Title"
                              FontSize="22"
                              Margin="0 0 0 16"/>

                <ui:TextBlock Appearance="Primary"
                              Text="Папка данных"
                              FontWeight="SemiBold"
                              Margin="0 0 0 8"/>

                <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                    <ui:TextBox PlaceholderText="Путь к папке данных..."
                                Width="500"
                                Text="{Binding DataDirectory, UpdateSourceTrigger=PropertyChanged}"
                                BorderThickness="2"/>
                    <ui:Button Appearance="Dark"
                               Content="..."
                               Width="30"
                               Margin="5 0 0 0"
                               Command="{Binding BrowseCommand}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                    <ui:Button Appearance="Success"
                               Content="Сохранить"
                               Margin="0 0 8 0"
                               Command="{Binding SaveCommand}"/>
                    <ui:Button Appearance="Secondary"
                               Content="По умолчанию (Temp)"
                               Command="{Binding ResetToDefaultCommand}"/>
                </StackPanel>

                <ui:TextBlock Appearance="Secondary"
                              Text="Файлы данных:"
                              FontWeight="SemiBold"
                              Margin="0 0 0 4"/>
                <ui:TextBlock Appearance="Secondary"
                              Text="{Binding QuickLinksPath}"
                              TextWrapping="Wrap"
                              Margin="0 0 0 4"/>
                <ui:TextBlock Appearance="Secondary"
                              Text="{Binding StatisticsPath}"
                              TextWrapping="Wrap"
                              Margin="0 0 0 16"/>

                <ui:TextBlock Appearance="Secondary"
                              Text="Изменения пути вступят в силу после перезапуска приложения."
                              FontWeight="SemiBold"
                              TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
